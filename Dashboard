.ins .in{background:var(--s);border:1px solid var(--bd);border-radius:12px;padding:10px 12px}.in .il{font-size:10.5px;text-transform:uppercase;letter-spacing:.6px;color:var(--mu)}.in .iv{font-weight:700;font-size:14px;margin:3px 0 6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
