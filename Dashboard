.sumc ul{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:6px 24px}.sumc li{font-size:13px;line-height:1.5;padding-left:14px;position:relative}.sumc li::before{content:'◆';position:absolute;left:0;color:var(--ac);font-size:8px;top:5px}
.kpis{grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.kpi{position:relative;padding:12px 14px 12px 16px}.kpi::before{content:'';position:absolute;left:0;top:12px;bottom:12px;width:3px;border-radius:3px;background:var(--ac)}
